{
  "manifest_version": 3,
  "name": "EdgeOperator AI • On-Device Web Agent",
  "version": "0.4.0.2",
  "description": "On-device AI agent & workflow operator for any website. Private SLMs, automated macros, 0 cloud API cost, 100% in-browser.",
  "author": "Adarrsh Paul <adarrsh@paulcreates.online>",
  "homepage_url": "https://agent.paulcreates.online",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "EdgeOperator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "css": [
        "content/style.css"
      ],
      "js": [
        "content/edge-operator.min.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "optional_permissions": [
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle_agent": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Toggle EdgeOperator"
    },
    "record_macro": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Start Teach 1 → Batch N Macro Recording"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/style.css",
        "content/edge-operator.min.js",
        "content/on-device-chat.min.js",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "version_name": "0.4.0-next.2"
}
