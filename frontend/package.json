{
  "name": "on-device-chat",
  "version": "0.3.0",
  "description": "On-device AI agent & workflow operator for any website. Private SLMs, automated macros, 0 cloud API cost, 100% in-browser.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "jsdelivr": "./dist/edge-operator.min.js",
  "unpkg": "./dist/edge-operator.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./standalone": "./dist/edge-operator.min.js",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "gemini-nano",
    "chrome-built-in-ai",
    "prompt-api",
    "window-ai",
    "on-device-ai",
    "local-first",
    "browser-ai",
    "webgpu",
    "webllm",
    "transformers-js",
    "ai-agent",
    "web-agent",
    "browser-automation",
    "rpa",
    "macro-recorder",
    "chat-widget",
    "copilot",
    "web-component",
    "react",
    "privacy",
    "offline",
    "edge-operator",
    "industrial-automation"
  ],
  "license": "Apache-2.0",
  "author": "Adarrsh Paul <adarrsh@paulcreates.online>",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adarrshpaul/on-device-chat.git",
    "directory": "frontend"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://agent.paulcreates.online",
  "bugs": {
    "url": "https://github.com/adarrshpaul/on-device-chat/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && vite build --config vite.standalone.config.ts && node scripts/scope-css.mjs && cp dist/on-device-chat.min.js dist/gemma4-agent.min.js && cp dist/on-device-chat.min.js dist/edge-operator.min.js && node scripts/sync-extension.mjs",
    "sync:extension": "node scripts/scope-css.mjs && node scripts/sync-extension.mjs",
    "build:extension": "npm run build && node scripts/sync-extension.mjs",
    "build:docs": "vite build --config vite.demo.config.ts",
    "test": "npm run test:giskard && npm run test:safety && npm run test:task117 && npm run test:todo && npm run test:voice && npm run test:grounding && npm run test:vega && npm run test:universal && npm run test:sota && npm run test:workflows && npm run test:specialty && npm run test:extension && npm run test:consistency && npm run test:industrial && npm run test:uispec && npm run test:eval",
    "test:task117": "node --experimental-strip-types tests/test_task_117_review_fixes.mjs",
    "test:eval": "node --experimental-strip-types tests/test_empirical_harness_eval.mjs",
    "test:giskard": "node --experimental-strip-types tests/giskard_stress_test.mjs",
    "test:safety": "node --experimental-strip-types tests/test_safety_gate.mjs",
    "test:todo": "node --experimental-strip-types tests/test_task_116_todo_and_reasoning.mjs",
    "test:voice": "node --experimental-strip-types tests/test_task_115_voice_input.mjs",
    "test:grounding": "node --experimental-strip-types tests/test_numeric_grounding_and_a11y.mjs",
    "test:vega": "node --experimental-strip-types tests/test_vega_engine.mjs",
    "test:universal": "node tests/test_universal_harness_architecture.mjs",
    "test:repeated": "node tests/test_repeated_actions.mjs",
    "test:sota": "node tests/test_web_agent_sota_benchmarks.mjs",
    "test:workflows": "node tests/test_workflow_predictor.mjs",
    "test:specialty": "node tests/test_model_specialty_matrix.mjs",
    "test:extension": "node tests/test_chrome_extension_sync_and_wrapper.mjs",
    "test:consistency": "node tests/test_cross_application_ui_consistency.mjs",
    "test:industrial": "node tests/test_industrial_ot_wbm_recognition.mjs",
    "test:uispec": "node tests/test_ui_spec_and_d3_nano.mjs",
    "e2e:extension": "npm run build:extension && playwright test --project=gate1-extension",
    "e2e:smoke": "playwright test --project=gate2-smoke",
    "release:gate1": "npm test && npm run lint && npm run e2e:extension",
    "release:next": "node scripts/release/version.mjs next",
    "release:stable": "node scripts/release/version.mjs stable",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run test:giskard && npm run lint && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "built-in-ai-task-apis-polyfills": "^1.19.0",
    "lucide-react": "^0.453.0",
    "marked": "^14.1.2",
    "prompt-api-polyfill": "^1.22.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0-beta.1",
    "@types/marked": "^6.0.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "playwright": "^1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0-beta.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8"
  }
}
